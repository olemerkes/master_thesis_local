@article{hillMechanismsForcedTropical2015,
  title = {Mechanisms of {{Forced Tropical Meridional Energy Flux Change}}},
  author = {Hill, Spencer A. and Ming, Yi and Held, Isaac M.},
  date = {2015-03-01},
  journaltitle = {Journal of Climate},
