@article{kimWeakHadleyCell2022,
  title = {Weak {{Hadley}} Cell Intensity Changes Due to Compensating Effects of Tropical and Extratropical Radiative Forcing},
  author = {Kim, Doyeon and Kim, Hanjun and Kang, Sarah M. and Stuecker, Malte F. and Merlis, Timothy M.},
