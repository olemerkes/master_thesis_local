	author = {{Deutscher Wetterdienst} and Riemer, Michael and Bertelmann, Magdalena},
	editor = {Riemer, Michael},
	editora = {Pfahl, Stephan},
	editoratype = {collaborator},
	urldate = {2026-05-18},
