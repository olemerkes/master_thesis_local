@article{deutscher_wetterdienst_promet_2025,
	title = {promet 108: Vorhersagbarkeit},
	rights = {Creative Commons Attribution 4.0 International},
	url = {https://www.dwd.de/DE/leistungen/pbfb_verlag_promet/pdf_promethefte/108_pdf.pdf?__blob=publicationFile&v=5},
	doi = {10.5676/DWD_PUB/PROMET_108},
	shorttitle = {promet 108},
	abstract = {Kaum ein anderes meteorologisches Thema ist für Wissenschaft, Wirtschaft und Allgemeinbevölkerung gleichermaßen so relevant wie die Vorhersage von Wetter. Doch wie vorhersagbar ist das Wetter überhaupt? Wo liegt die intrinsische Grenze, welche Prozesse erschweren oder erhöhen vielleicht auch die Vorhersagbarkeit?
Diesen Fragen wird in sieben Beiträgen nachgegangen. Dabei werden neben der klassischen Kurzfristvorhersage unter anderem auch die Besonderheit von saisonalen Vorhersagen und die speziellen Bedingungen in den Tropen behandelt.},
